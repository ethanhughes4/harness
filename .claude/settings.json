{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "WebSearch"
    ],
    "ask": [
      "Bash(pip install *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run_tests.py"
            ],
            "timeout": 510
          }
        ]
      }
    ]
  }
}
